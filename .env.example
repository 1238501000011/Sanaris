# Optional backend configuration. Copy to .env.local; do not commit real credentials.
# The local dev launcher stays on 127.0.0.1:5173; PORT/HOST apply to npm start.
HOST=127.0.0.1
PORT=4173
# SANARIS_DATABASE_PATH=/persistent-disk/sanaris.sqlite
# Exact frontend origins, comma-separated, without paths or trailing slashes.
# SANARIS_ALLOWED_ORIGINS=https://YOUR-ACCOUNT.github.io
# First boot on a hosted backend only: set a unique password of at least 12 characters.
# SANARIS_INITIAL_ADMIN_PASSWORD=
# Public frontend settings (API URL, Google Maps browser key, sensor feed path)
# belong in docs/config.js. Never put passwords or device secrets in that file.
